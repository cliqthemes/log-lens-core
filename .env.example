# Copy to .env and adjust. Real environment variables override these.
# .env is git-ignored so your secrets are never committed.

# Canonical base URL. Leave unset: the dashboard and API derive their base from
# the request. Only the command-line AI skills need it (they have no request to
# derive from), as does pinning a URL behind a proxy.
# LOG_LENS_URL=https://logs.example.com

# API key. Leave empty for unauthenticated local use. When set, every API
# request must send it as `X-Log-Lens-Token: <token>` or
# `Authorization: Bearer <token>`.
LOG_LENS_TOKEN=
